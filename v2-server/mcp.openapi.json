              "type": "string"
            }
          }
        },
        "required": [
          "identifier",
          "revision",
          "values"
        ],
        "additionalProperties": false
      },
      "McpInstallInput": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "pluginVersion": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
