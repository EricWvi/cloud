            }
          },
          "complete": {
            "type": "boolean"
          },
          "settingsMissing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "pluginVersion",
          "revision",
          "state",
          "settings",
          "values",
          "configuredSecrets",
          "complete",
          "settingsMissing"
