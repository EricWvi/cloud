          "taskId": {
            "type": "string"
          },
          "workflowRunId": {
            "type": "string"
          },
          "workflowId": {
            "type": "string"
          },
          "workflowName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "startedBy": {
            "type": "string"
