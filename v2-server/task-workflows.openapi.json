          "workflowRunId",
          "workflowId",
          "workflowName",
          "version",
          "startedBy",
          "startedByName",
          "status",
          "failure",
          "kind",
          "createdCount",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
