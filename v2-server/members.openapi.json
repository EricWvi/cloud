{
  "openapi": "3.0.3",
  "info": {
    "title": "Temporary v2 members and invitations",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v2/tenants/{tid}/members": {
      "post": {
        "operationId": "inviteMember",
        "tags": [
          "members"
        ],
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitedMember"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "500": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tenants/{tid}/members/{uid}": {
      "delete": {
        "operationId": "removeMember",
        "tags": [
          "members"
        ],
        "description": "Ends one person's membership and their squad memberships in this workspace; the account stays. Owner only. 409 last_owner, 404 member_not_found.",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Response"
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tenants/{tid}/invite-links": {
      "post": {
        "operationId": "createInviteLink",
        "tags": [
          "members"
        ],
        "description": "Creates a one-time member link, valid for 7 days, optionally joining one live squad. The token appears only in this response's url: absolute under V2_PUBLIC_URL, otherwise site-relative. Owner only. 404 squad_not_found.",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteLinkInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInviteLink"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listInviteLinks",
        "tags": [
          "members"
        ],
        "description": "Links still usable, then the used ones; expired or revoked links nobody used are left out. Owner only.",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteLinkList"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tenants/{tid}/invite-links/{id}": {
      "delete": {
        "operationId": "revokeInviteLink",
        "tags": [
          "members"
        ],
        "description": "Revokes a link nobody used yet. Owner only. 409 invite_already_used, 404 invite_not_found.",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Response"
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invites/preview": {
      "post": {
        "operationId": "previewInvite",
        "tags": [
          "invites"
        ],
        "description": "Where a link leads and whether it can still be used, for the signed-in user; changes nothing. The token is in the body so it stays out of access logs. 404 invite_not_found.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTokenInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitePreview"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invites/accept": {
      "post": {
        "operationId": "acceptInvite",
        "tags": [
          "invites"
        ],
        "description": "Joins the signed-in user to the link's workspace and uses the link up; a member already in it gets the workspace back and the link stays unused. 410 invite_unavailable with params.reason used, expired or revoked; 404 invite_not_found.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTokenInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedInvite"
                }
              }
            }
          },
          "400": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "401": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "403": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "404": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          },
          "410": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteMemberInput": {
        "type": "object",
        "required": [
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "squadId": {
            "type": "string"
          }
        }
      },
      "InvitedMember": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "userId",
          "displayName",
          "role",
          "status",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "actorDisplayName": {
            "type": "string",
            "nullable": true
          },
          "joinMethod": {
            "type": "string",
            "nullable": true
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MemberError": {
        "type": "object",
        "required": [
          "code",
          "params",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "InviteSquad": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "InviteTenant": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateInviteLinkInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "squadId": {
            "type": "string"
          }
        }
      },
      "InviteLink": {
        "type": "object",
        "required": [
          "id",
          "role",
          "squad",
          "createdByName",
          "createdAt",
          "expiresAt",
          "usedByName",
          "usedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "squad": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InviteSquad"
              }
            ],
            "nullable": true
          },
          "createdByName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "usedByName": {
            "type": "string",
            "nullable": true
          },
          "usedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreatedInviteLink": {
        "type": "object",
        "required": [
          "link",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "link": {
            "$ref": "#/components/schemas/InviteLink"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "InviteLinkList": {
        "type": "object",
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InviteLink"
            }
          }
        }
      },
      "InviteTokenInput": {
        "type": "object",
        "required": [
          "token"
        ],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "InvitePreview": {
        "type": "object",
        "required": [
          "state",
          "tenant",
          "squad",
          "role",
          "alreadyMember"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "used",
              "expired",
              "revoked"
            ]
          },
          "tenant": {
            "$ref": "#/components/schemas/InviteTenant"
          },
          "squad": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InviteSquad"
              }
            ],
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "alreadyMember": {
            "type": "boolean"
          }
        }
      },
      "AcceptedInvite": {
        "type": "object",
        "required": [
          "tenantId"
        ],
        "additionalProperties": false,
        "properties": {
          "tenantId": {
            "type": "string"
          }
        }
      }
    }
  }
}
